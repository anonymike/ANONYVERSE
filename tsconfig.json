{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": [
      "node",
      "nativewind/types",
      "expo/types"
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@shared/*": [
        "./shared/*"
      ],
      "@anonyverse/shared": [
        "./packages/shared/src/index.ts"
      ],
      "@anonyverse/api": [
        "./packages/api/src/index.ts"
      ],
      "@anonyverse/config": [
        "./packages/config/src/index.ts"
      ],
      "@anonyverse/validation": [
        "./packages/validation/src/index.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "apps/web"
  ]
}
